# Create the TUN device
ip tuntap add dev tun0 mode tun

# Assign the server an IP in the VPN subnet
ip addr add 10.0.0.1/24 dev tun0

# Bring the interface up
ip link set dev tun0 up

# Enable IP forwarding (so the server can route traffic)
sysctl -w net.ipv4.ip_forward=1

# Set up NAT (so VPN clients can access the internet)
iptables -t nat -A POSTROUTING -s 10.0.0.0/24 -o eth0 -j MASQUERADE

# Allow forwarded traffic
iptables -P FORWARD ACCEPT



client:

# Create the TUN device
ip tuntap add dev tun0 mode tun

# Assign the client an IP in the same subnet
ip addr add 10.0.0.2/24 dev tun0

# Bring the interface up
ip link set dev tun0 up

# Add routes to send traffic through the VPN
ip route add 0.0.0.0/1 via 10.0.0.1 dev tun0
ip route add 128.0.0.0/1 via 10.0.0.1 dev tun0
